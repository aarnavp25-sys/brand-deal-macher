# Creator index (separate Supabase project). Copy to index/.env and fill in. Never commit index/.env.
INDEX_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
INDEX_SUPABASE_SERVICE_KEY=
# optional, only for `python3 index/collect.py migrate` (or paste schema.sql in the SQL editor)
INDEX_SUPABASE_ACCESS_TOKEN=
# Apify keys, label:token,label:token,...
INDEX_APIFY_TOKENS=
INDEX_PORT=8789
