# Copy to admin/.env (never commit it). Values: Supabase dashboard -> Project Settings -> API keys.
SUPABASE_URL=https://yqaducvspzrqokcqwlga.supabase.co
SUPABASE_SERVICE_KEY=paste-service-role-or-secret-key-here
ADMIN_PORT=8787
# Optional: Apify accounts for the live credits card. Comma separated label:token pairs.
# APIFY_TOKENS=acc1:apify_api_xxx,acc2:apify_api_yyy

# Public anon key (safe in the browser; RLS blocks direct table reads). Used by demo/server.py.
SUPABASE_ANON_KEY=
# Supabase personal access token (supabase.com -> Account -> Access Tokens): migrations, secrets, function deploy.
SUPABASE_ACCESS_TOKEN=
# Amazon Bedrock long-term API key (works only in ap-southeast-2). Used by pipeline/llm_classify.py;
# the Edge Function gets its own copy as a Supabase secret.
BEDROCK_API_KEY=
