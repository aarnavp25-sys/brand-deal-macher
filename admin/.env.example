# Copy to admin/.env (never commit it). One file holds every key the project uses.

# Supabase (dashboard -> Project Settings -> API keys)
SUPABASE_URL=https://yqaducvspzrqokcqwlga.supabase.co
SUPABASE_SERVICE_KEY=paste-service-role-key-here        # secret: pipeline + admin only
SUPABASE_ANON_KEY=                                      # public by design (RLS blocks table reads); written by `supabase/deploy.py anon`
SUPABASE_ACCESS_TOKEN=                                  # personal access token (supabase.com -> Account -> Access Tokens): migrations, secrets, deploy
ADMIN_PORT=8787

# Apify accounts, comma separated label:token pairs (admin credits card, pipeline/round.py --account <label>)
APIFY_TOKENS=acc1:apify_api_xxx,acc2:apify_api_yyy

# Anthropic API key for Claude Haiku 5.5 (pipeline/llm_classify.py; `supabase/deploy.py secrets` copies it to the Edge Function)
ANTHROPIC_API_KEY=
